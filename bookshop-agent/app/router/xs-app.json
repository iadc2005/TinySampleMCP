{
  "routes": [
    {
      "source": "^/\\.well-known/(.*)$",
      "target": "/.well-known/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/mcp(.*)$",
      "target": "/mcp$1",
      "destination": "srv-api",
      "authenticationType": "ias",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "csrfProtection": true
    }
  ]
}
